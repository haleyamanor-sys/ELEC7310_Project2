
% PHYSICAL CONSTANTS AND MATERIAL PROPERTIES

c0 = 3e8;                    % Speed of light (m/s)
mu0 = 4*pi*1e-7;             % Free-space permeability
eps0 = 1/(mu0*c0^2);         % Free-space permittivity
eta0 = sqrt(mu0/eps0);       % Free-space impedance

f0 = 20e6;                   % Design frequency (Hz)

eps1 = 2;
eps2 = 3;
epsL = 2.25;

mu1 = 1;
mu2 = 1;
muL = 1;

eta1 = eta0/sqrt(eps1);
eta2 = eta0/sqrt(eps2);
etaL = eta0/sqrt(epsL);

fprintf('ANTI-REFLECTIVE COATING DESIGN\n');

fprintf('Free-space impedance: %.2f Ohms\n',eta0);
fprintf('Layer 1 impedance: %.2f Ohms\n',eta1);
fprintf('Layer 2 impedance: %.2f Ohms\n',eta2);
fprintf('Substrate impedance: %.2f Ohms\n',etaL);

% CALCULATE LAYER THICKNESSES

d1 = c0/(4*f0*sqrt(eps1*mu1));
d2 = c0/(4*f0*sqrt(eps2*mu2));

fprintf('\nCOATING THICKNESSES\n');
fprintf('Layer 1 thickness: %.4f m\n',d1);
fprintf('Layer 2 thickness: %.4f m\n',d2);

Zin2_design = eta2^2/etaL;
Zin_design = eta1^2/Zin2_design;

Gamma_design = (Zin_design-eta0)/(Zin_design+eta0);

fprintf('\nTheoretical input impedance: %.4f Ohms\n',Zin_design);
fprintf('Theoretical reflection at 20 MHz: %.8f\n', ...
    abs(Gamma_design));

% Frequency range
f_analytical = linspace(1e6,50e6,1500);

Gamma_analytical = zeros(size(f_analytical));

for k = 1:length(f_analytical)

    f = f_analytical(k);

    % Phase constants
    beta1 = 2*pi*f*sqrt(eps1*mu1)/c0;
    beta2 = 2*pi*f*sqrt(eps2*mu2)/c0;

    % Input impedance looking into Layer 2
    Zin2 = eta2 * ...
        (etaL + 1j*eta2*tan(beta2*d2)) / ...
        (eta2 + 1j*etaL*tan(beta2*d2));

    % Input impedance looking into Layer 1
    Zin1 = eta1 * ...
        (Zin2 + 1j*eta1*tan(beta1*d1)) / ...
        (eta1 + 1j*Zin2*tan(beta1*d1));

    % Overall reflection coefficient
    Gamma_analytical(k) = ...
        (Zin1-eta0)/(Zin1+eta0);

end

% FDTD SIMULATION PARAMETERS

dx = 0.05;                  % Spatial step (m)

% Courant stability condition
dt = 0.95*dx/(c0*sqrt(eps2*mu2));

xmax = 100;                 % Simulation domain (m)
x = 0:dx:xmax;

Nx = length(x);

tmax = 1.5e-6;              % Simulation duration (s)
Nt = ceil(tmax/dt);

t = (0:Nt-1)*dt;

% Source and measurement positions
source_x = 8;
probe_x = 14;

[~,isrc] = min(abs(x-source_x));
[~,iprobe] = min(abs(x-probe_x));

% DEFINE MATERIAL DISTRIBUTION

% Reference simulation: Air everywhere
epsr_ref = ones(1,Nx);

% Coated simulation
epsr = ones(1,Nx);

% Layer boundaries
x1 = 25;
x2 = x1+d1;
x3 = x2+d2;

% Snap boundaries to nearest FDTD grid points
i1 = round(x1/dx)+1;
i2 = round(x2/dx)+1;
i3 = round(x3/dx)+1;

% Assign dielectric materials
epsr(i1:i2-1) = eps1;
epsr(i2:i3-1) = eps2;
epsr(i3:end) = epsL;

fprintf('Actual Layer 1 thickness: %.4f m\n', ...
    (i2-i1)*dx);

fprintf('Actual Layer 2 thickness: %.4f m\n', ...
    (i3-i2)*dx);

% GAUSSIAN-MODULATED SINUSOIDAL SOURCE

sigma_t = 25e-9;
t0 = 6*sigma_t;

source = sin(2*pi*f0*(t-t0)) .* ...
    exp(-((t-t0).^2)/(2*sigma_t^2));

% REFERENCE FDTD SIMULATION

fprintf('\nRunning reference FDTD simulation...\n');

E_reference = runFDTD( ...
    epsr_ref,dx,dt,Nt,Nx,isrc,iprobe, ...
    source,eps0,mu0,c0);

fprintf('Reference simulation complete.\n');

% COATED FDTD SIMULATION

fprintf('\nRunning coated FDTD simulation...\n');

E_coated = runFDTD( ...
    epsr,dx,dt,Nt,Nx,isrc,iprobe, ...
    source,eps0,mu0,c0);

fprintf('Coated simulation complete.\n');

% EXTRACT INCIDENT AND REFLECTED FIELDS

% Incident field from reference simulation
E_incident = E_reference;

% Reflected field from subtraction
E_reflected = E_coated-E_reference;
